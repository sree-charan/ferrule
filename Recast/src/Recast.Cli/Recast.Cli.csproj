<!--
  Recast.Cli: the "recast" command line. Converts files and watches folders without the tray app, with the same
  engines, presets and settings. Published next to Recast.exe as recast-cli.exe (one runtime for both); the installer
  puts a "recast" shim on PATH (cli\recast.cmd).
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>recast-cli</AssemblyName>
    <RootNamespace>Recast.Cli</RootNamespace>
    <ApplicationIcon>..\Recast.App\Assets\Icons\recast.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Recast.Core\Recast.Core.csproj" />
    <ProjectReference Include="..\Recast.Engines\Recast.Engines.csproj" />
  </ItemGroup>

  <!-- Error messages and built-in preset names, in English (the app's translation file). -->
  <ItemGroup>
    <EmbeddedResource Include="..\Recast.App\Assets\i18n\en.json" LogicalName="Recast.Cli.en.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Recast.Cli.Tests" />
  </ItemGroup>
</Project>
