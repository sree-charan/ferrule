// Version information of the Explorer context-menu DLL. build/build-explorer-menu.ps1 passes the app version as
// RECAST_VERSION_MAJOR/MINOR/PATCH and RECAST_VERSION_TEXT.

#include <winver.h>

#ifndef RECAST_VERSION_MAJOR
#define RECAST_VERSION_MAJOR 0
#define RECAST_VERSION_MINOR 0
#define RECAST_VERSION_PATCH 0
#define RECAST_VERSION_TEXT "0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION RECAST_VERSION_MAJOR, RECAST_VERSION_MINOR, RECAST_VERSION_PATCH, 0
PRODUCTVERSION RECAST_VERSION_MAJOR, RECAST_VERSION_MINOR, RECAST_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Sree Charan"
            VALUE "FileDescription", "Recast File Explorer context menu"
            VALUE "FileVersion", RECAST_VERSION_TEXT
            VALUE "InternalName", "RecastExplorerMenu"
            VALUE "LegalCopyright", "Copyright (c) 2026 Sree Charan. MIT License."
            VALUE "OriginalFilename", "RecastExplorerMenu.dll"
            VALUE "ProductName", "Recast"
            VALUE "ProductVersion", RECAST_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
