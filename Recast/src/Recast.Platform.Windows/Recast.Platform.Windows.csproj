<!--
  Recast.Platform.Windows: Windows implementation of IPlatformServices
  (Explorer detection & selection, context menu, auto-start, system metrics, .lnk shortcut targets).
  Targets plain net10.0 so the cross-platform app can reference it; every entry point is guarded
  with [SupportedOSPlatform("windows")] and only used when OperatingSystem.IsWindows() is true.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Recast.Platform.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Recast.Core\Recast.Core.csproj" />
    <InternalsVisibleTo Include="Recast.Platform.Tests" />
  </ItemGroup>
</Project>
